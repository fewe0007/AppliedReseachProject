<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Row with Title and Add Suite Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_housekeeper"
                    android:textColor="@color/text_header"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_welcome"
                    android:textColor="@color/text_subtext"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Small Top Button: Add Suite -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSuite"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_add_suite"
                android:textColor="@color/btn_assigned_suites_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/btn_assigned_suites"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <!-- 4 Vertical Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssignedSuites"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_assigned_suites"
            android:textColor="@color/btn_assigned_suites_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_assigned_suites"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#40000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletedSuites"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_completed_suites"
            android:textColor="@color/btn_completed_suites_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_completed_suites"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#40000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncServer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_sync_server"
            android:textColor="@color/btn_sync_server_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_sync_server"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#40000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_logout"
            android:textColor="@color/btn_logout_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_logout"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            app:rippleColor="#40000000" />

    </LinearLayout>
</ScrollView>