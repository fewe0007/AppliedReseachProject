<resources>
    <!-- Base application theme. -->
    <style name="Theme.AppliedReseachProject" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/btn_completed_suites</item>
        <item name="colorPrimaryVariant">@color/btn_completed_suites_text</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/btn_assigned_suites</item>
        <item name="colorSecondaryVariant">@color/btn_assigned_suites_text</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>